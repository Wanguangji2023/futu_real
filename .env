# FutuOpenD连接
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# 交易模式：demo（模拟）或 live（实盘），默认demo
TRADE_MODE=demo
# 市场：CN / HK / US（用于实盘权限校验）
MARKET=HK

# 可选：指定账户ID（若不指定则自动选择第一个匹配的账户）
FUTU_ACCOUNT_ID=

# 资金与风控
BUY_RATIO=0.01           # 每次买入占总可用资金的比例（1%）
MIN_BUY_AMOUNT=2500     # 单笔最小买入金额（基础货币单位）
COOLDOWN_DAYS=7          # 卖出后静默天数（该标的暂停交易）
PROFIT_TRIGGER=0.05      # 触发动态止盈的最小盈利率（5%）
STOP_LOSS=0.015          # 初始止损比例（1.5%，实际由止盈表动态决定）

# 日志
LOG_LEVEL=INFO           # DEBUG / INFO / WARNING / ERROR
LOG_MAX_BYTES=20971520   # 单个日志文件大小（20MB）
LOG_BACKUP_COUNT=5       # 保留备份文件数量

# 钉钉告警（可选）
DINGTALK_WEBHOOK_futu=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET_futu=SECxxx




# # | 变量名 | 默认值 | 说明 |
# # |---|---|---|
# FUTU_OPEND_HOST=127.0.0.1#` | `127.0.0.1` | FutuOpenD 地址 |
# FUTU_OPEND_PORT=11111 #` | `11111` | FutuOpenD 端口 |
# MARKET=HK#` | `HK` | 运行市场：`CN`=A股 / `HK`=港股 / `US`=美股 |
# TRADE_MODE=demo#` | `demo` | `demo`=#模拟盘 / `live`=实盘（**CN 强制 demo，忽略此值**） |
# MIN_BUY_AMOUNT=5000
# COOLDOWN_DAYS=7
# DINGTALK_WEBHOOK_futu="https://oapi.dingtalk.com/robot/send?access_token=4e01ee9e777f18d3975b2791c6fd408b3101e8a7877970a465457a82ee542a37"
# DINGTALK_SECRET_futu="SEC0fb1b7e85a357c285a9809012911b944bc1eadb20cd238adb1d388bddd787604"  

